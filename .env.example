# Operator supplies a domain pointing to the chosen server. No hosting is created by this file.
DAITIN_DOMAIN=pilot.example.com
# Default intentionally makes no remote model call.
DAI_TIN_MODEL_MODE=disabled
# For a permitted OpenAI-compatible HTTPS service, set mode=enabled and complete the following.
# Provider must support the existing response_format json_schema contract.
DAI_TIN_MODEL_ENDPOINT=
DAI_TIN_MODEL_ID=
# Place provider key in the persistent /data/model.key, permission 0600; never here.
