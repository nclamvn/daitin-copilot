{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 180,
      "includeFiles": "{corpus/**,copilot/**,sot/**,public/**,distribution/demo/**,patents/*.mjs,patents/ui/**,patents/data/catalog.json,patents/data/snapshots/**,patents/data/extracts/**,node_modules/pdfjs-dist/standard_fonts/**,node_modules/pdfjs-dist/cmaps/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs,node_modules/@napi-rs/**}",
      "excludeFiles": "{test/**,work/**,copilot/evals/**,copilot/m4/pilot/**,copilot/m4/acceptance/**,copilot/m5/pilot/**,copilot/m5/acceptance/**,**/*.jsonl,**/*.key,**/*.gguf,**/__pycache__/**}"
    }
  },
  "routes": [
    { "src": "/__sources/[a-f0-9]{64}\\.pdf", "headers": { "Cache-Control": "public, max-age=31536000, immutable", "X-Content-Type-Options": "nosniff" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/api/index" }
  ]
}
